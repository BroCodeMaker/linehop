# Production - Neon PostgreSQL
# DATABASE_URL will be set in Vercel environment variables
# Format: postgresql://username:password@host.neon.tech/dbname

NEXTAUTH_SECRET=generate-a-random-secret-and-set-in-vercel
NEXTAUTH_URL=https://your-domain.com

# WhatsApp - Use real provider in production
WHATSAPP_PROVIDER=twilio
WHATSAPP_API_URL=https://api.twilio.com
WHATSAPP_API_TOKEN=your-twilio-token-here
WHATSAPP_PHONE_NUMBER_ID=your-phone-number-id
WHATSAPP_WEBHOOK_VERIFY_TOKEN=your-webhook-token

# Timers
CONFIRM_TIMEOUT_SECONDS=120
ARRIVAL_TIMEOUT_SECONDS=300
