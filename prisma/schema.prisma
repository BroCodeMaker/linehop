generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Restaurant {
  id         String              @id @default(uuid())
  name       String
  slug       String              @unique
  timezone   String              @default("Europe/Bucharest")
  status     String              @default("OPEN")
  listClosed Boolean             @default(false)
  createdAt  DateTime            @default(now())
  settings   RestaurantSettings?
  users      RestaurantUser[]
  entries    WaitlistEntry[]
  errorLogs  ErrorLog[]
  qrTokens   QrToken[]
  auditLogs  AuditLog[]
}

model AuditLog {
  id           String     @id @default(cuid())
  restaurantId String
  entryId      String?
  action       String
  actorEmail   String?
  metadata     Json?
  createdAt    DateTime   @default(now())

  restaurant   Restaurant @relation(fields: [restaurantId], references: [id])

  @@index([restaurantId, createdAt])
}

model QrToken {
  id             String      @id @default(cuid())
  token          String      @unique
  status         String      @default("unclaimed")
  restaurantId   String?
  restaurant     Restaurant? @relation(fields: [restaurantId], references: [id])
  createdAt      DateTime    @default(now())
  claimedAt      DateTime?
  firstScannedAt DateTime?
  notes          String?
}

model RestaurantSettings {
  id                    String     @id @default(uuid())
  restaurantId          String     @unique
  confirmTimerSec       Int        @default(120)
  arrivalTimerSec       Int        @default(300)
  bufferVisibilitySec   Int        @default(600)
  maxCallAgain          Int        @default(1)
  maxPartySize          Int        @default(10)
  maxQueueSize          Int        @default(50)
  waitMinutesPerGroup   Int        @default(10)
  estimatedTableTimeMin Int        @default(15)
  msgWhatsappCall       String     @default("Vă rugăm să vă prezentați la intrare în 2 minute.")
  msgWhatsappExpire     String     @default("Din păcate locul dumneavoastră a expirat.")
  msgWhatsappCallAgain  String     @default("Vă mai acordăm o șansă, vă rugăm să vă prezentați.")
  msgWhatsappWaiting    String     @default("📣 Mulțumim pentru răbdare, {name}! Mai sunt {position} grupuri înaintea dvs. Încă sunteți în lista noastră de așteptare.")
  useCalculatedAvgTime  Boolean    @default(false)
  updatedAt             DateTime   @updatedAt
  restaurant            Restaurant @relation(fields: [restaurantId], references: [id], onDelete: Cascade)
}

model RestaurantUser {
  id           String     @id @default(uuid())
  restaurantId String
  email        String
  passwordHash String
  role         String     @default("staff")
  isActive     Boolean    @default(true)
  createdAt    DateTime   @default(now())
  restaurant   Restaurant @relation(fields: [restaurantId], references: [id], onDelete: Cascade)

  @@unique([restaurantId, email])
}

model WaitlistEntry {
  id                String         @id @default(uuid())
  restaurantId      String
  publicToken       String         @unique
  partySize         Int
  phoneE164         String
  guestName         String?
  status            String
  createdAt         DateTime       @default(now())
  calledAt          DateTime?
  confirmedAt       DateTime?
  seatedAt          DateTime?
  skippedAt         DateTime?
  expiredAt         DateTime?
  expiredReason     String?
  canceledAt        DateTime?
  confirmDeadlineAt DateTime?
  arrivalDeadlineAt DateTime?
  callAgainCount        Int            @default(0)
  notes                 String?
  lastWaitingNotifiedAt DateTime?
  messageEvents     MessageEvent[]
  restaurant        Restaurant     @relation(fields: [restaurantId], references: [id], onDelete: Cascade)

  @@index([restaurantId, status, createdAt])
}

model ErrorLog {
  id           String     @id @default(uuid())
  restaurantId String
  subject      String
  description  String
  status       String     @default("open")
  createdAt    DateTime   @default(now())
  restaurant   Restaurant @relation(fields: [restaurantId], references: [id], onDelete: Cascade)

  @@index([restaurantId, status, createdAt])
}

model MessageEvent {
  id         String        @id @default(uuid())
  entryId    String
  direction  String        @default("outbound")
  provider   String        @default("mock")
  phoneE164  String
  body       String
  status     String        @default("sent")
  externalId String?
  createdAt  DateTime      @default(now())
  entry      WaitlistEntry @relation(fields: [entryId], references: [id], onDelete: Cascade)

  @@index([entryId, direction, createdAt])
}

model DemoRequest {
  id             String    @id @default(cuid())
  restaurantName String
  phone          String
  city           String
  position       Int
  createdAt      DateTime  @default(now())
  contactedAt    DateTime?
}
